# Copy to .env and adjust. The password is embedded in a connection URL,
# so use URL-safe characters, e.g. the output of: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_USER=slonbase
POSTGRES_DB=slonbase
SLONBASE_PORT=8090
# The slonbase release to run, e.g. 0.5.0 (default: latest)
#SLONBASE_VERSION=0.5.0
